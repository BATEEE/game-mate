# ── Server ──
SERVER_PORT=8080
SERVER_MODE=debug
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s

# ── PostgreSQL ──
DB_HOST=localhost
DB_PORT=5432
DB_USER=gamemate
DB_PASSWORD=gamemate_secret
DB_NAME=gamemate
DB_SSL_MODE=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=5

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ──
JWT_SECRET=super-secret-change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=gamemate

# ── MinIO (S3-compatible Object Storage) ──
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gamemate
MINIO_USE_SSL=false
